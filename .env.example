# ============================================================
# NBOX License Server - Environment Variables
# ============================================================
# Copy file này thành .env.local để chạy local
# Trên Vercel: vào Settings > Environment Variables để thêm

# ─── LICENSES_JSON ──────────────────────────────────────────
# Danh sách license keys dạng JSON array.
# Mỗi key có thể có config riêng hoặc dùng DEFAULT_CONFIG.
#
# Fields:
#   key        (string)  - License key, ví dụ: NBOX-ABCD-1234-EFGH
#   isActive   (boolean) - true = kích hoạt được, false = bị khóa
#   expiresAt  (string|null) - ISO date hoặc null (vĩnh viễn)
#   machineId  (string|null) - Tự động điền khi user kích hoạt lần đầu
#   activatedAt(string|null) - Tự động điền
#   config     (object|null) - Override config riêng, null = dùng default
#
# Ví dụ với 3 licenses:
LICENSES_JSON=[{"key":"NBOX-TEST-0001-AAAA","isActive":true,"expiresAt":"2027-12-31T23:59:59.000Z","machineId":null,"activatedAt":null,"config":null},{"key":"NBOX-TEST-0002-BBBB","isActive":true,"expiresAt":null,"machineId":null,"activatedAt":null,"config":null},{"key":"NBOX-DEMO-9999-ZZZZ","isActive":false,"expiresAt":null,"machineId":null,"activatedAt":null,"config":null}]
